<%= form_with(model: ticket) do |form| %>
  <% if ticket.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(ticket.errors.count, "error") %> prevented this ticket from being saved:</h2>

      <ul>
        <% ticket.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <div>
    <%= form.label :status %><br>
    <%= form.select :status,
        [["Open", "Open"],
         ["In Progress", "In Progress"],
         ["Resolved", "Resolved"]] %>
  </div>

  <div>
    <%= form.label :priority %><br>
    <%= form.select :priority,
        [["Low", "Low"],
         ["Medium", "Medium"],
         ["High", "High"],
         ["Critical", "Critical"]] %>
  </div>

  <div>
    <%= form.label :due_date %><br>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.label :project_id, "Project" %><br>
    <%= form.collection_select :project_id,
        Project.order(:name),
        :id,
        :name,
        { prompt: "Select a project" } %>
  </div>

  <br>

  <div>
    <%= form.submit %>
  </div>
<% end %>
